# ClickHouse 22.3.10.22: HTTP protocol on 8123.
DATABASE_URL=clickhouse://melat:CHANGE_ME@127.0.0.1:8123/netmeta
# Or reuse the native TCP protocol on 9000:
# DATABASE_URL=clickhouse+native://default:CHANGE_ME@127.0.0.1:9000/netmeta
PCAP_WORK_DIR=/data/melat/native-imports
MELAT_STATE_DIR=/data/melat/native-state
TZ=UTC
